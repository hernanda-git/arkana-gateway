# ============================================================
# ARKANA GATEWAY — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by docker compose.

# ── n8n Encryption Key (REQUIRED) ──
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-random-hex-string

# ── n8n User Credentials ──
# Used by the Gateway for cookie-based session auth against n8n's internal API.
# Create an owner/admin user in n8n first (http://localhost:5678), then set these.
N8N_USER_EMAIL=
N8N_USER_PASSWORD=

# ── Dashboard Admin Login (SEC-ARKANA-003) ──
# AUTH=1 enables cookie auth on the Blazor dashboard. The admin credential below
# is what you log in with. The seeder creates the user on first boot and refreshes
# the password whenever this value changes. Keep this OUT of version control.
ARKANA_ADMIN_USER=admin
ARKANA_ADMIN_PASSWORD=
