<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>50a5ce93-386d-4cb4-a5fd-5b6950c7244e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arkana.Gateway.Api\Arkana.Gateway.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.2" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.2" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.4.2" />
  </ItemGroup>

  <!-- MessagePack 2.5.192 is pulled transitively by Aspire's distributed-tracing
       stack (only used for in-process IPC inside the AppHost). None of these
       advisories are exploitable from the gateway: we never accept untrusted
       MessagePack input. Tracked for upgrade when Aspire 13.5+ ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2f33-pr97-265q" />
