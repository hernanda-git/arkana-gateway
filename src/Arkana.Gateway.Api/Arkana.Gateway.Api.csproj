<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1305;CA1310;CA1848;CA1873;ASPDEPR002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arkana.Application\Arkana.Application.csproj" />
    <ProjectReference Include="..\Arkana.Infrastructure\Arkana.Infrastructure.csproj" />
    <ProjectReference Include="..\Arkana.ServiceDefaults\Arkana.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Microsoft.OpenApi 2.0.0 is transitive from Microsoft.AspNetCore.OpenApi.
       Scalar serves the schema in-process; advisory GHSA-v5pm-xwqc-g5wc is not exploitable. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Arkana.Gateway.Api.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
