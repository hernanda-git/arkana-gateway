{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=arkana;Username=your_user;Password=your_password"
  },
  "ProviderOptions": {
    "OpenCode": {
      "BaseUrl": "https://opencode.ai/zen/go/v1",
      "ApiKey": "",
      "DefaultModel": "deepseek-v4-flash"
    },
    "OpenAI": {
      "ApiKey": ""
    }
  },
  "N8n": {
    "BaseUrl": "http://localhost:5678",
    "UserEmail": "",
    "UserPassword": ""
  },
  "Auth": {
    "Enabled": false
  },
  "ResponseCache": {
    "Enabled": true,
    "DefaultTtlSeconds": 300
  },
  "SemanticCache": {
    "Enabled": false,
    "SimilarityThreshold": 0.92,
    "DefaultTtlSeconds": 300,
    "QdrantHost": "localhost",
    "QdrantPort": 6334
  },
  "MeteringQueue": {
    "Enabled": true,
    "MaxBatchSize": 100,
    "FlushInterval": "00:00:02",
    "Capacity": 10000,
    "EnqueueTimeout": "00:00:00.050"
  },
  "RateLimiter": {
    "Enabled": true,
    "DefaultRequestsPerMinute": 60,
    "DefaultTokensPerMinute": 1000000,
    "DefaultMaxConcurrent": 5,
    "Overrides": {},
    "CleanupInterval": "00:05:00",
    "BucketIdleTtl": "00:15:00"
  },
  "Compression": {
    "InputEnabled": false,
    "OutputEnabled": false,
    "CharsPerToken": 4.0,
    "PerMessageCharBudget": 16000,
    "HeadTailKeepRatio": 0.2
  },
  "DefaultTimeZone": "Asia/Jakarta"
}
