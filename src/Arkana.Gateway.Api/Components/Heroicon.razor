@* Heroicon - standardized icon component for the AI Gateway dashboard.
   Uses the official Heroicons (outline, 24x24) path data.
   Usage:  <Heroicon Name="home" />                       (1em / 20px via CSS)
           <Heroicon Name="key" Size="16" Class="extra" />
   Any icon rendered through this component is guaranteed to be a Heroicon.
*@
@using Microsoft.AspNetCore.Components.Web
@namespace Arkana.Gateway.Api.Components

@if (Paths is null)
{
    <!-- unknown heroicon: @Name -->
}
else
{
    <svg @attributes="AdditionalAttributes"
         class="@Class"
         xmlns="http://www.w3.org/2000/svg"
         fill="none"
         viewBox="0 0 24 24"
         stroke-width="@StrokeWidth"
         stroke="currentColor"
         width="@Size"
         height="@Size"
         aria-hidden="true"
         data-slot="icon">
        @((MarkupString)Paths)
    </svg>
}

