@page "/knowledge-base"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime Js

<PageTitle>Knowledge Base</PageTitle>

<div class="kb-page">
    <div class="kb-toolbar">
        <div class="kb-toolbar-left">
            <span class="kb-title">Vault Graph</span>
            <span class="kb-count" id="kb-count">&hellip;</span>
        </div>
        <div class="kb-toolbar-right">
            <label class="kb-search">
                <Heroicon Name="magnifying-glass" Size="16" />
                <input id="kb-search" type="text" placeholder="Search notes…" />
            </label>
            <button class="kb-btn" id="kb-fit" title="Fit graph"><Heroicon Name="squares-2x2" Size="15" /> Fit</button>
        </div>
    </div>

    <div class="kb-body">
        <aside class="kb-sidebar" id="kb-sidebar">
            <div class="kb-sidebar-head">Vault</div>
            <div id="kb-filetree" class="kb-tree"></div>
        </aside>

        <section class="kb-graph">
            <div class="kb-graph-body" id="kb-graph-body"></div>
            <div id="kb-loading" class="kb-loading">Loading knowledge base…</div>
            <div class="kb-graph-controls">
                <button class="kb-ctrl" data-a="in" title="Zoom in" aria-label="Zoom in">+</button>
                <button class="kb-ctrl" data-a="out" title="Zoom out" aria-label="Zoom out">&minus;</button>
                <button class="kb-ctrl" data-a="reset" title="Fit graph" aria-label="Fit graph">
                    <Heroicon Name="squares-2x2" Size="16" />
                </button>
            </div>
        </section>
    </div>

    <div class="kb-note-panel" id="kb-note-panel">
        <div class="kb-note-head">
            <span class="kb-note-title" id="kb-note-title"></span>
            <button class="kb-btn kb-note-close" id="kb-note-close"><Heroicon Name="x-mark" Size="15" /> Close</button>
        </div>
        <div class="kb-note-body" id="kb-note-body"></div>
    </div>
</div>

@* Load the themed graph module + marked from the /kb static mount *@
<script src="/kb/marked.min.js"></script>
<script src="/kb/kb-graph.js"></script>
<script>
    (function () {
        function boot() { if (window.KBGraph) window.KBGraph.init(); }
        if (document.readyState === 'complete' || document.readyState === 'interactive') setTimeout(boot, 0);
        else document.addEventListener('DOMContentLoaded', boot);
        // Blazor may re-render; retry a few times until #kb-graph-body exists.
        var tries = 0;
        var iv = setInterval(function () {
            if (document.getElementById('kb-graph-body')) {
                if (window.KBGraph && !window.__kbBooted) { window.__kbBooted = true; window.KBGraph.init(); }
                clearInterval(iv);
            } else if (++tries > 40) clearInterval(iv);
        }, 150);

        document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('[data-a]');
            if (a) {
                var act = a.getAttribute('data-a');
                if (act === 'in') window.__kbZoom && window.__kbZoom(1.2);
                else if (act === 'out') window.__kbZoom && window.__kbZoom(1 / 1.2);
                else if (act === 'reset') window.__kbFit && window.__kbFit();
            }
            if (e.target.closest && e.target.closest('#kb-fit')) window.__kbFit && window.__kbFit();
            if (e.target.closest && e.target.closest('#kb-note-close')) window.KBGraph && window.KBGraph.closeNote();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.KBGraph && window.KBGraph.closeNote();
        });
    })();
</script>

<style>
    /* Full-window override: let the KB page bleed to the edges of the content area
       (other pages keep the standard .content padding + 1440px cap). */
    .content:has(.kb-page) {
        padding: 0;
        max-width: none;
        margin: 0;
        overflow: hidden;
    }

    .kb-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - var(--topbar-h));
        min-height: 0;
        background: var(--bg);
        position: relative;
    }

    .kb-toolbar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--bg-elevated);
        flex: 0 0 auto;
    }
    .kb-toolbar-left { display: flex; align-items: center; gap: 10px; }
    .kb-title { font-size: 14px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
    .kb-count {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-muted);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        padding: 3px 10px;
        border-radius: 100px;
    }
    .kb-toolbar-right { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 10px; }

    .kb-search {
        display: flex; align-items: center; gap: 8px;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 7px 12px;
        color: var(--text-muted);
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }
    .kb-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(229,106,74,0.12); }
    .kb-search svg { width: 16px; height: 16px; color: var(--text-muted); flex: 0 0 auto; }
    .kb-search input { border: none; background: transparent; outline: none; color: var(--text); font-size: 13px; width: 240px; }
    .kb-search input::placeholder { color: var(--text-muted); }

    .kb-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        padding: 7px 12px;
        font-size: 13px;
        cursor: pointer;
        transition: all var(--transition-fast);
    }
    .kb-btn:hover { border-color: var(--accent); color: var(--accent); }
    .kb-btn svg { width: 15px; height: 15px; }

    .kb-body { flex: 1; display: flex; min-height: 0; }

    .kb-sidebar {
        width: 264px;
        flex: 0 0 264px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--border);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }
    .kb-sidebar-head {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        padding: 16px 16px 8px;
        font-weight: 600;
    }
    .kb-tree { padding: 0 8px 16px; }
    .kb-tree-folder {
        color: var(--text-secondary);
        padding: 6px 10px;
        font-size: 13px;
        cursor: pointer;
        user-select: none;
        border-radius: var(--radius-sm);
        font-weight: 500;
    }
    .kb-tree-folder:hover { color: var(--text); background: var(--sidebar-hover); }
    .kb-tree-file {
        color: var(--text-secondary);
        padding: 6px 10px 6px 24px;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        border-radius: var(--radius-sm);
    }
    .kb-tree-file:hover { background: var(--sidebar-hover); color: var(--text); }
    .kb-tree-file.active { background: var(--sidebar-active); color: var(--accent); font-weight: 500; }

    .kb-graph {
        flex: 1;
        position: relative;
        min-width: 0;
        background: radial-gradient(120% 120% at 50% 0%, var(--bg-elevated), var(--bg));
    }
    .kb-graph-body { position: absolute; inset: 0; }
    .kb-loading {
        position: absolute; inset: 0;
        display: flex; align-items: center; justify-content: center;
        color: var(--text-muted); font-size: 14px;
    }
    .kb-graph-controls {
        position: absolute; right: 16px; bottom: 16px;
        display: flex; flex-direction: column; gap: 8px;
    }
    .kb-ctrl {
        width: 36px; height: 36px;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: var(--bg-elevated);
        color: var(--text-secondary);
        font-size: 18px;
        cursor: pointer;
        transition: all var(--transition-fast);
        box-shadow: var(--shadow-sm);
        display: flex; align-items: center; justify-content: center;
    }
    .kb-ctrl:hover { border-color: var(--accent); color: var(--accent); }
    .kb-ctrl svg { width: 16px; height: 16px; }

    .kb-note-panel {
        position: absolute; top: 0; right: 0; bottom: 0;
        width: 50%; min-width: 340px;
        background: var(--bg-elevated);
        border-left: 1px solid var(--border);
        overflow-y: auto;
        overflow-x: hidden;
        box-shadow: var(--shadow-elev);
        display: none;
        z-index: 6;
        animation: kb-slide .22s ease;
    }
    @@keyframes kb-slide { from { transform: translateX(16px); opacity: 0; } to { transform: none; opacity: 1; } }
    .kb-note-panel.open { display: block; }
    .kb-note-head {
        position: sticky; top: 0;
        background: var(--bg-elevated);
        border-bottom: 1px solid var(--border);
        padding: 12px 16px;
        display: flex; align-items: center; gap: 10px;
        z-index: 2;
    }
    .kb-note-title { font-size: 14px; font-weight: 600; color: var(--text); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kb-note-body { padding: 24px 28px 40px; color: var(--text); font-size: 15px; line-height: 1.75; }
    .kb-note-body > *:first-child { margin-top: 0; }
    .kb-note-body > *:last-child { margin-bottom: 0; }
    .kb-note-body h1 { font-size: 22px; font-weight: 700; line-height: 1.3; margin: 0 0 16px; color: var(--text); letter-spacing: -0.01em; }
    .kb-note-body h2 { font-size: 18px; font-weight: 650; line-height: 1.35; margin: 28px 0 12px; color: var(--text); padding-bottom: 6px; border-bottom: 1px solid var(--border); }
    .kb-note-body h3 { font-size: 15.5px; font-weight: 650; line-height: 1.4; margin: 22px 0 10px; color: var(--text); }
    .kb-note-body h4, .kb-note-body h5, .kb-note-body h6 { font-size: 14px; font-weight: 650; margin: 18px 0 8px; color: var(--text-secondary); }
    .kb-note-body p { margin: 0 0 14px; }
    .kb-note-body ul, .kb-note-body ol { margin: 0 0 14px; padding-left: 22px; }
    .kb-note-body li { margin: 4px 0; }
    .kb-note-body li > ul, .kb-note-body li > ol { margin: 6px 0; }
    .kb-note-body a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-subtle); transition: all var(--transition-fast); }
    .kb-note-body a:hover { border-bottom-color: var(--accent); }
    .kb-note-body strong { font-weight: 650; color: var(--text); }
    .kb-note-body em { font-style: italic; }
    .kb-note-body code { background: var(--bg-subtle); padding: 2px 6px; border-radius: 5px; font-size: 13px; font-family: var(--font-mono); color: var(--accent-500); }
    .kb-note-body pre { background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 16px; overflow-x: auto; margin: 0 0 16px; }
    .kb-note-body pre code { background: none; padding: 0; color: var(--text); font-size: 13px; }
    .kb-note-body blockquote { border-left: 3px solid var(--accent); margin: 0 0 16px; padding: 6px 16px; color: var(--text-secondary); background: var(--bg-subtle); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
    .kb-note-body blockquote p:last-child { margin-bottom: 0; }
    .kb-note-body hr { border: none; border-top: 1px solid var(--border); margin: 24px 0; }
    .kb-note-body img { max-width: 100%; border-radius: var(--radius-sm); margin: 4px 0 16px; }
    .kb-note-body table { border-collapse: collapse; width: 100%; margin: 0 0 16px; font-size: 14px; }
    .kb-note-body th, .kb-note-body td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
    .kb-note-body th { background: var(--bg-subtle); font-weight: 600; color: var(--text); }
    .kb-note-body tr:nth-child(even) td { background: var(--bg-subtle); }
    /* Obsidian [[wikilinks]] rendered as inline links */
    .kb-note-body a.kb-wikilink { color: var(--accent); border-bottom: 1px solid var(--accent-subtle); cursor: pointer; }
    .kb-note-body a.kb-wikilink::before { content: ''; }
    .kb-note-body .kb-wikilink-missing { color: var(--text-muted); border-bottom: 1px dotted var(--text-muted); cursor: help; }
</style>
