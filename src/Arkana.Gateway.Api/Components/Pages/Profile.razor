    /// <summary>Prominent bind-result alert. Success auto-dismisses after ~6s; error stays until closed.</summary>
    private sealed record BindAlert(bool Succeeded, string Message, DateTimeOffset ShownAt);
    private BindAlert? _bindAlert;
    private bool _binding;

    private bool _ownerKeysPinned;
    private bool _showPoolDetail = true;
    private DashboardService.UsageStats? _stats;
    private List<DashboardService.ModelUsageView>? _modelUsage;
