@page "/profile"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout ChromeLessLayout
@attribute [Authorize]
@implements IDisposable
@using Arkana.Domain.Interfaces
@using Arkana.Gateway.Api.Services
@using Arkana.Gateway.Api.Endpoints
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDashboardUserRepository DashboardUsers
@inject ITenantProvider TenantProvider
@inject DashboardService Dashboard
@inject UserTimeService UserTime

<PageTitle>Profile · ARKANA GATEWAY</PageTitle>

<div class="profile-page">
    <header class="profile-header">
        <div class="profile-identity">
            <div class="profile-avatar" aria-hidden="true">
                <span class="material-symbols-outlined">account_circle</span>
            </div>
            <div>
                <div class="eyebrow">Google OAuth profile</div>
                <h1>@(_name ?? _email ?? "Your profile")</h1>
                <p>@(_email ?? "Signed in with Google")</p>
            </div>
        </div>
        <div class="profile-header-actions">
            <span class="role-badge">@_role</span>
            <button class="profile-action" @onclick="RefreshAsync" disabled="@_loading">
                <span class="material-symbols-outlined">refresh</span>
                @( _loading ? "Refreshing…" : "Refresh")
            </button>
            <a class="profile-action profile-action-danger" href="/logout">
                <span class="material-symbols-outlined">logout</span>
                Sign out
            </a>
            <a class="profile-action" href="/docs">
                <span class="material-symbols-outlined">menu_book</span>
                Docs
            </a>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <div class="profile-alert" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@_loadError</span>
        </div>
    }

    <main class="profile-content">

        @* ── Bind result alert: always explicit, success auto-dismisses ── *@
        @if (_bindAlert is not null)
        {
            <div class="bind-alert bind-alert-@(_bindAlert.Succeeded ? "success" : "error")" role="alert" aria-live="polite">
                <span class="material-symbols-outlined">@( _bindAlert.Succeeded ? "check_circle" : "error")</span>
                <span class="bind-alert-text">@_bindAlert.Message</span>
                <button type="button" class="bind-alert-close" aria-label="Dismiss" @onclick="DismissBindAlert">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>
        }

        @* ── Subscription quota — split by what the bound keys actually route to ── *@
        @{
            var quotaAccounts = _usage?.Accounts ?? [];
            var codexAccounts = quotaAccounts.Where(a => a.Kind == "codex").ToList();
            var antigravityAccounts = quotaAccounts.Where(a => a.Kind == "antigravity").ToList();
            var otherPinned = quotaAccounts.Where(a => a.Kind == "other").ToList();
        }

        @if (codexAccounts.Count > 0)
        {
            <section class="profile-section">
                <div class="section-heading">
                    <div>
                        <div class="eyebrow">Subscription usage</div>
                        <h2>ChatGPT Codex quota windows</h2>
                    </div>
                    <span class="section-caption">
                        @if (_usage is { HasData: true })
                        {
                            <text>as of @UserTime.Format(DateTimeOffset.UtcNow, "HH:mm")</text>
                        }
                        else
                        {
                            <text>Rolling 5-hour &amp; weekly limits</text>
                        }
                    </span>
                </div>

                @{
                    var codexWindows = codexAccounts.SelectMany(a => a.Windows).ToList();
                }
                @if (codexWindows.Count == 0)
                {
                    <div class="profile-empty">
                        <span class="material-symbols-outlined">hourglass_empty</span>
                        <span>No usage data yet — this fills in automatically once the first request flows through the gateway.</span>
                    </div>
                }
                else
                {
                    <div class="usage-grid">
                        @foreach (var w in codexWindows)
                        {
                            <UsageCard Window="w" Now="_now" />
                        }
                    </div>
                }

                @if (_usage is { Pool.Count: > 0 } && _showPoolDetail)
                {
                    <div class="pool-block">
                        <div class="pool-caption">Account pool (@_usage.Pool.Count @(_usage.Pool.Count == 1 ? "account" : "accounts"))</div>
                        <table class="pool-table">
                            <thead>
                                <tr><th>Account</th><th>5-hour</th><th>Weekly</th><th>5h resets</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in _usage.Pool)
                                {
                                    var p = acc.Windows.FirstOrDefault(w => w.Window == "5h");
                                    var s = acc.Windows.FirstOrDefault(w => w.Window == "week");
                                    var pinBadge = codexWindows.Any(x => x.AccountCode == acc.AccountCode);
                                    <tr>
                                        <td>@acc.AccountCode @(pinBadge ? "· your key" : "")</td>
                                        <td><span class="usage-pill @PercentClass(p?.UsedPercent)">@(p is null ? "—" : $"{p.UsedPercent:F0}%")</span></td>
                                        <td><span class="usage-pill @PercentClass(s?.UsedPercent)">@(s is null ? "—" : $"{s.UsedPercent:F0}%")</span></td>
                                        <td class="muted">@(p?.ResetsAtUtc is null ? "—" : FormatCountdown(p.ResetsAtUtc.Value))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (antigravityAccounts.Count > 0)
        {
            <section class="profile-section">
                <div class="section-heading">
                    <div>
                        <div class="eyebrow">Subscription usage</div>
                        <h2>Antigravity quota</h2>
                    </div>
                    <span class="section-caption">Gemini subscriptions your keys route through</span>
                </div>

                <div class="pf-quota-grid">
                    @foreach (var acc in antigravityAccounts)
                    {
                        var cooldown = acc.QuotaCooldownUntil;
                        var cooldownActive = cooldown.HasValue && cooldown.Value > DateTimeOffset.UtcNow;
                        <div class="pf-quota-account">
                            <div class="pf-pf-quota-account-head">
                                <div>
                                    <strong>@acc.DisplayName</strong>
                                    <div class="muted pf-quota-sub">@acc.AccountCode · routed via the Gemini broker</div>
                                </div>
                                <span class="usage-pill @AccountStatusClass(acc.Status)">@AccountStatusLabel(acc.Status)</span>
                            </div>
                            <dl class="pf-quota-meta">
                                <div>
                                    <dt>Quota throttle</dt>
                                    <dd>@(cooldownActive ? $"cooldown until {FormatCountdown(cooldown!.Value)}" : "none active")</dd>
                                </div>
                                <div>
                                    <dt>Last success</dt>
                                    <dd>@(acc.LastSuccessAt is null ? "—" : UserTime.Format(acc.LastSuccessAt.Value, "dd MMM HH:mm"))</dd>
                                </div>
                                <div>
                                    <dt>Last failure</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(acc.LastFailureClass) ? "—" : acc.LastFailureClass)</dd>
                                </div>
                                <div>
                                    <dt>Token</dt>
                                    <dd>@(acc.TokenExpiresAt is null ? "—" : $"expires {UserTime.Format(acc.TokenExpiresAt.Value, "dd MMM HH:mm")}")</dd>
                                </div>
                            </dl>
                            @if (acc.HasSnapshots)
                            {
                                <div class="usage-grid">
                                    @foreach (var w in acc.Windows)
                                    {
                                        <UsageCard Window="w" Now="_now" />
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="usage-note">Google publishes no usage window for this subscription; the values above are the quota state the gateway observes while routing to this account.</p>
                            }
                        </div>
                    }
                </div>

                @if (_usage is { HasData: true })
                {
                    <div class="pool-block">
                        <div class="pool-caption">Codex account pool (@_usage.Pool.Count @(_usage.Pool.Count == 1 ? "account" : "accounts"))</div>
                        <table class="pool-table">
                            <thead>
                                <tr><th>Account</th><th>5-hour</th><th>Weekly</th><th>5h resets</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var acc in _usage.Pool)
                                {
                                    var p = acc.Windows.FirstOrDefault(w => w.Window == "5h");
                                    var s = acc.Windows.FirstOrDefault(w => w.Window == "week");
                                    <tr>
                                        <td>@acc.AccountCode</td>
                                        <td><span class="usage-pill @PercentClass(p?.UsedPercent)">@(p is null ? "—" : $"{p.UsedPercent:F0}%")</span></td>
                                        <td><span class="usage-pill @PercentClass(s?.UsedPercent)">@(s is null ? "—" : $"{s.UsedPercent:F0}%")</span></td>
                                        <td class="muted">@(p?.ResetsAtUtc is null ? "—" : FormatCountdown(p.ResetsAtUtc.Value))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (codexAccounts.Count == 0 && antigravityAccounts.Count == 0)
        {
            <section class="profile-section">
                <div class="section-heading">
                    <div>
                        <div class="eyebrow">Subscription usage</div>
                        <h2>Provider quota</h2>
                    </div>
                    <span class="section-caption">Per provider you route to</span>
                </div>
                <div class="profile-empty">
                    <span class="material-symbols-outlined">key</span>
                    @if (otherPinned.Count > 0)
                    {
                        <span>Your keys are pinned to @string.Join(", ", otherPinned.Select(a => a.AccountCode)) — this provider publishes no quota windows here.</span>
                    }
                    else
                    {
                        <span>Bind an API key (below) to see its provider's quota here — ChatGPT Codex accounts show rolling windows, Gemini subscription accounts show their Antigravity quota state.</span>
                    }
                </div>
            </section>
        }

        <section class="profile-section profile-overview">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">Account overview</div>
                    <h2>Usage this month</h2>
                </div>
                <span class="section-caption">Your gateway activity</span>
            </div>
            <div class="profile-stat-grid">
                <div class="profile-stat">
                    <span class="stat-label">Requests</span>
                    <strong>@(_stats?.Requests ?? 0)</strong>
                    <small>completed requests</small>
                </div>
                <div class="profile-stat">
                    <span class="stat-label">Total tokens</span>
                    <strong>@FormatNumber(_stats?.TotalTokens ?? 0)</strong>
                    <small>@FormatNumber(_stats?.InputTokens ?? 0) in · @FormatNumber(_stats?.OutputTokens ?? 0) out</small>
                </div>
                <div class="profile-stat">
                    <span class="stat-label">Estimated cost</span>
                    <strong>$@((_stats?.Cost ?? 0m).ToString("F4"))</strong>
                    <small>provider-reported usage</small>
                </div>
            </div>
        </section>

        <div class="profile-columns">
            <section class="profile-section">
                <div class="section-heading">
                    <div>
                        <div class="eyebrow">Identity &amp; access</div>
                        <h2>API key binding</h2>
                    </div>
                    <span class="coming-badge">Profile-scoped</span>
                </div>
                <p class="section-description">
                    Bind an API key by proving possession of its full secret. The secret is hashed
                    for lookup and is never stored or displayed.
                </p>
                <div class="bind-form">
                    <input class="bind-input" type="password" value="@_keyToBind"
                           @oninput="OnBindKeyInput" @onkeydown="OnBindKeyDown"
                           placeholder="Paste the full API key" autocomplete="off" />
                    <button type="button"
                            class="profile-action bind-button @(_binding ? "is-busy" : "")"
                            @onclick="BindKeyAsync"
                            disabled="@_binding"
                            aria-busy="@_binding">
                        @if (_binding)
                        {
                            <span class="material-symbols-outlined bind-spinner" aria-hidden="true">progress_activity</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" aria-hidden="true">link</span>
                        }
                        @(_binding ? "Binding…" : "Bind key")
                    </button>
                </div>
                @if (_apiKeys is { Count: > 0 })
                {
                    <div class="key-list">
                        @foreach (var key in _apiKeys)
                        {
                            var pinnedTo = key.PreferredProviderCode;
                            <div class="key-row">
                                <div>
                                    <strong>@key.Name</strong>
                                    <span class="key-prefix">@key.Prefix · created @UserTime.Format(key.CreatedAt, "MMM dd, yyyy")</span>
                                    <div class="pf-key-routing">
                                        @if (!string.IsNullOrWhiteSpace(pinnedTo))
                                        {
                                            <span class="pf-key-chip">routes to @pinnedTo</span>
                                            <span class="pf-key-chip @(key.AllowProviderFallback ? "pf-key-chip-fallback" : "")">
                                                @(key.AllowProviderFallback ? "fallback allowed" : "pinned only")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="pf-key-chip pf-key-chip-warn">no provider pin — the gateway picks the route</span>
                                        }
                                        <span class="pf-key-chip pf-key-chip-bound">bound to this profile</span>
                                    </div>
                                </div>
                                <span class="status-pill @(key.IsActive ? "status-active" : "status-inactive")">
                                    @(key.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        }
                    </div>
                }
                else if (!_loading)
                {
                    <div class="profile-empty">
                        <span class="material-symbols-outlined">key</span>
                        <span>No API keys are available yet.</span>
                    </div>
                }
            </section>

            <section class="profile-section">
                <div class="section-heading">
                    <div>
                        <div class="eyebrow">Breakdown</div>
                        <h2>Usage by model</h2>
                    </div>
                    <span class="section-caption">Monthly</span>
                </div>
                @if (_modelUsage is { Count: > 0 })
                {
                    <div class="model-list">
                        @foreach (var model in _modelUsage.Where(m => m.Requests > 0))
                        {
                            <div class="model-row">
                                <div>
                                    <strong>@model.ModelName</strong>
                                    <span>@model.ProviderName</span>
                                </div>
                                <div class="model-metrics">
                                    <strong>@model.Requests</strong>
                                    <span>@FormatNumber(model.TotalTokens) tokens</span>
                                </div>
                            </div>
                        }
                    </div>
                    @if (!_modelUsage.Any(m => m.Requests > 0))
                    {
                        <div class="profile-empty"><span class="material-symbols-outlined">bar_chart</span><span>No usage data this month.</span></div>
                    }
                }
                else if (!_loading)
                {
                    <div class="profile-empty"><span class="material-symbols-outlined">bar_chart</span><span>No usage data this month.</span></div>
                }
            </section>
        </div>

        <section class="profile-section profile-logs">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">Audit trail</div>
                    <h2>Recent request logs</h2>
                </div>
                <span class="section-caption">
                    @if (_logTotal > 0)
                    {
                        <text>@FormatNumber(_logTotal) requests · page @_logPage of @LogTotalPages</text>
                    }
                    else
                    {
                        <text>Every request made with your keys</text>
                    }
                </span>
            </div>
            @if (_logRows is { Count: > 0 })
            {
                <div class="log-table-wrap">
                    <table class="profile-table pf-log-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Provider</th>
                                <th>Model</th>
                                <th>API key</th>
                                <th>Tokens</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in _logRows)
                            {
                                var isOpen = _openLogId == log.Id;
                                <tr class="pf-log-row @(isOpen ? "is-open" : "") @(log.IsError ? "is-error" : "")"
                                    @onclick="() => ToggleLogDetailAsync(log.Id)">
                                    <td class="muted">@UserTime.Format(log.Timestamp, "MMM dd, HH:mm")</td>
                                    <td>@log.Provider</td>
                                    <td class="mono">@log.Model</td>
                                    <td>@(log.ApiKeyName ?? "—")</td>
                                    <td>@FormatNumber(log.TotalTokens)</td>
                                    <td>
                                        <span class="status-pill @(log.IsError ? "status-error" : "status-active")">
                                            @(log.IsError ? "Error" : "OK")
                                        </span>
                                        <span class="pf-caret @(isOpen ? "open" : "")" aria-hidden="true">chevron_right</span>
                                    </td>
                                </tr>
                                @if (isOpen)
                                {
                                    <tr class="pf-detail-row">
                                        <td colspan="6">
                                            @if (_openLog is null)
                                            {
                                                <div class="pf-loading"><span class="material-symbols-outlined bind-spinner">progress_activity</span> Loading full log…</div>
                                            }
                                            else
                                            {
                                                var full = _openLog;
                                                <div class="pf-detail-panel">
                                                    <div class="pf-section">
                                                        <div class="pf-section-title"><span class="material-symbols-outlined">forum</span> Request messages</div>
                                                        @if (full.Messages is { Count: > 0 })
                                                        {
                                                            <div class="pf-messages">
                                                                @foreach (var msg in full.Messages)
                                                                {
                                                                    <div class="pf-msg @($"pf-role-{msg.Role}")">
                                                                        <span class="pf-role">@msg.Role</span>
                                                                        <pre class="pf-content"><code>@msg.Content</code></pre>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="pf-empty">No request messages captured</div>
                                                        }
                                                    </div>

                                                    <div class="pf-section">
                                                        <div class="pf-section-title"><span class="material-symbols-outlined">code</span> Tool calls</div>
                                                        @if (full.ToolCalls is { Count: > 0 })
                                                        {
                                                            @foreach (var tc in full.ToolCalls)
                                                            {
                                                                <div class="pf-tool">
                                                                    <div class="pf-tool-head"><span class="pf-key-chip">@tc.Type</span> <code>@tc.FunctionName</code></div>
                                                                    <pre class="pf-content"><code>@FormatJson(tc.FunctionArguments)</code></pre>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="pf-empty">No tool calls in this exchange</div>
                                                        }
                                                    </div>

                                                    <div class="pf-section">
                                                        <div class="pf-section-title"><span class="material-symbols-outlined">auto_awesome</span> AI response</div>
                                                        @if (!string.IsNullOrEmpty(full.ResponseContent))
                                                        {
                                                            <pre class="pf-content pf-response"><code>@full.ResponseContent</code></pre>
                                                        }
                                                        @if (full.IsError && !string.IsNullOrEmpty(full.ErrorMessage))
                                                        {
                                                            <div class="pf-error">
                                                                <div class="pf-error-label">Error</div>
                                                                <pre><code>@full.ErrorMessage</code></pre>
                                                            </div>
                                                        }
                                                        @if (string.IsNullOrEmpty(full.ResponseContent) && !full.IsError)
                                                        {
                                                            <div class="pf-empty">No response content</div>
                                                        }
                                                    </div>

                                                    <div class="pf-section">
                                                        <div class="pf-section-title"><span class="material-symbols-outlined">info</span> Metadata</div>
                                                        <div class="pf-meta-grid">
                                                            <div class="pf-meta-item"><span>Request ID</span><span class="mono">@full.Id</span></div>
                                                            <div class="pf-meta-item"><span>Timestamp</span><span>@UserTime.Format(full.Timestamp, "yyyy-MM-dd HH:mm:ss")</span></div>
                                                            <div class="pf-meta-item"><span>Provider</span><span>@full.Provider</span></div>
                                                            <div class="pf-meta-item"><span>Model</span><span class="mono">@full.Model</span></div>
                                                            <div class="pf-meta-item"><span>Route</span><span>@full.RouteKind</span></div>
                                                            <div class="pf-meta-item"><span>Account</span><span class="mono">@(full.ResolvedProviderAccountCode ?? "—")</span></div>
                                                            <div class="pf-meta-item"><span>API key</span><span>@(full.ApiKeyName ?? "—")</span></div>
                                                            <div class="pf-meta-item"><span>Tokens</span><span>@FormatNumber(full.InputTokens) in · @FormatNumber(full.OutputTokens) out · @FormatNumber(full.TotalTokens) total</span></div>
                                                            <div class="pf-meta-item"><span>Cost</span><span>$@full.Cost.ToString("F6")</span></div>
                                                            <div class="pf-meta-item"><span>Duration</span><span>@full.DurationMs ms</span></div>
                                                            @if (!string.IsNullOrEmpty(full.ViaMitmAgent))
                                                            {
                                                                <div class="pf-meta-item"><span>Via MITM agent</span><span>@full.ViaMitmAgent</span></div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pf-pager">
                    <label class="pf-pager-size">
                        Rows
                        <select value="@_logPageSize" @onchange="OnLogPageSizeChangedAsync">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </label>
                    <div class="pf-pager-buttons">
                        <button type="button" class="profile-action pf-pager-button" disabled="@(_logPage <= 1 || _logsLoading)" @onclick="() => GoToLogPageAsync(1)">First</button>
                        <button type="button" class="profile-action pf-pager-button" disabled="@(_logPage <= 1 || _logsLoading)" @onclick="() => GoToLogPageAsync(_logPage - 1)">Prev</button>
                        <span class="pf-pager-status">@_logPage / @LogTotalPages</span>
                        <button type="button" class="profile-action pf-pager-button" disabled="@(_logPage >= LogTotalPages || _logsLoading)" @onclick="() => GoToLogPageAsync(_logPage + 1)">Next</button>
                        <button type="button" class="profile-action pf-pager-button" disabled="@(_logPage >= LogTotalPages || _logsLoading)" @onclick="() => GoToLogPageAsync(LogTotalPages)">Last</button>
                    </div>
                </div>
            }
            else if (!_loading)
            {
                <div class="profile-empty"><span class="material-symbols-outlined">description</span><span>No request logs yet.</span></div>
            }
        </section>
    </main>
</div>

<style>
    .profile-page { width: min(1440px, 100%); margin: 0 auto; }
    .profile-header { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:28px 36px; border-bottom:1px solid var(--profile-border); background:var(--profile-surface); }
    .profile-identity, .profile-header-actions, .profile-action, .key-row, .model-row, .profile-empty { display:flex; align-items:center; }
    .profile-identity { gap:16px; min-width:0; }
    .profile-avatar { width:52px; height:52px; border-radius:16px; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,var(--profile-accent),#b94f38); flex:0 0 auto; }
    .profile-avatar .material-symbols-outlined { font-size:31px; }
    .profile-header h1 { margin:4px 0 2px; font-size:22px; color:var(--profile-text); font-weight:700; }
    .profile-header p { margin:0; color:var(--profile-muted); font-size:13px; overflow-wrap:anywhere; }
    .profile-header-actions { gap:8px; flex-wrap:wrap; justify-content:flex-end; }
    .profile-action { gap:7px; padding:9px 12px; border:1px solid var(--profile-border); border-radius:9px; background:var(--profile-surface); color:var(--profile-text); text-decoration:none; font:inherit; font-size:13px; cursor:pointer; transition:border-color .15s ease, color .15s ease; }
    .profile-action:hover:not(:disabled) { border-color:var(--profile-accent); color:var(--profile-accent); }
    /* Cursor semantics: idle+enabled = pointer; disabled = not-allowed;
       in-flight ONLY while a request is actually running (.is-busy). */
    .profile-action:not(:disabled) { cursor:pointer; }
    .profile-action:disabled { opacity:.55; cursor:not-allowed; }
    .profile-action.is-busy { cursor:progress; }
    .profile-action-danger { color:#b94f38; }
