        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return raw;
        }
    }

    /// <summary>Maps ProviderAccountStatus (and snapshot-only states) to a pill class.</summary>
    private static string AccountStatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "connected" or "tracked" => "ok",
        "pending" or "draining" => "warn",
        "reconnectrequired" or "outofsync" or "missingcredential" or "disabled" => "crit",
        _ => ""
    };

    private static string AccountStatusLabel(string? status) => status?.ToLowerInvariant() switch
    {
        "connected" => "Connected",
        "pending" => "Pending",
        "draining" => "Draining",
        "disabled" => "Disabled",
        "reconnectrequired" => "Reconnect required",
        "outofsync" => "Out of sync",
        "missingcredential" => "Missing credential",
        "tracked" => "Tracked",
        "no-data" or null or "" => "No data yet",
        _ => status!
    };

    private static string PercentClass(double? percent) => percent switch
    {
        null => "",
        > 90 => "crit",
        >= 70 => "warn",
        _ => "ok"
    };

    /// <summary>"resets in HH:MM" countdown against the ticking clock.</summary>
    private string FormatCountdown(DateTimeOffset resetsAtUtc)
    {
        var remaining = resetsAtUtc - _now;
        if (remaining <= TimeSpan.Zero)
            return "now";
        if (remaining.TotalDays >= 2)
            return $"in {(int)remaining.TotalDays}d {remaining.Hours}h";
        if (remaining.TotalHours >= 1)
            return $"in {remaining.Hours}h {remaining.Minutes:D2}m";
        return $"in {remaining.Minutes}m {(int)remaining.Seconds:D2}s";
    }

    private static string FormatNumber(int value) => value switch
    {
        >= 1_000_000 => $"{value / 1_000_000.0:F1}M",
        >= 1_000 => $"{value / 1_000.0:F1}K",
        _ => value.ToString("N0")
    };
}
