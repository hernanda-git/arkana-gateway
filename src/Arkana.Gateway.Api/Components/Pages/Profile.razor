    private List<DashboardService.LogSummaryView>? _logRows;
    private int _logTotal;
    private int _logPage = 1;
    private int _logPageSize = 25;
    private bool _logsLoading;
    private Guid? _openLogId;
    private DashboardService.LogEntryView? _openLog;

    private int LogTotalPages => _logPageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(_logTotal / (double)_logPageSize));

    /// <summary>Ticking clock for live countdowns — disposed with the circuit.</summary>
    private readonly System.Timers.Timer _clockTimer =
        new(TimeSpan.FromSeconds(30).TotalMilliseconds) { AutoReset = true };
    private DateTimeOffset _now = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                 ?? user.FindFirst("email")?.Value
                 ?? user.Identity?.Name;
        _name = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
        _role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";

        var rawOwnerId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var rawTenantId = user.FindFirst("TenantId")?.Value;
        var claimTenantId = Guid.TryParse(rawTenantId, out var parsedTenantId)
            ? parsedTenantId
            : (Guid?)null;
        var tenantId = TenantProvider.TenantId ?? claimTenantId;

        if (tenantId is not { } currentTenantId || currentTenantId == Guid.Empty)
        {
            _ownerUserId = Guid.Empty;
            _loadError = "The signed-in profile has no valid tenant context. Sign out and sign in again.";
        }
        else
        {
            if (!Guid.TryParse(rawOwnerId, out _ownerUserId) && !string.IsNullOrWhiteSpace(_email))
            {
                // Older dashboard cookies may not carry the stable database id.
                // Resolve the already-provisioned user, but only within the
                // authenticated tenant; new Google logins carry the id directly.
                var persistedUser = await DashboardUsers.GetByUsernameAsync(_email);
                _ownerUserId = persistedUser?.TenantId == currentTenantId
                    ? persistedUser.Id
                    : Guid.Empty;
            }

            // Never trust a client/session id without checking its persisted
            // tenant. This also protects legacy cookies with stale claims.
            if (_ownerUserId != Guid.Empty)
            {
                var persistedUser = await DashboardUsers.GetByIdAsync(_ownerUserId);
                if (persistedUser is null || persistedUser.TenantId != currentTenantId)
                    _ownerUserId = Guid.Empty;
            }
        }

        if (_ownerUserId == Guid.Empty)
            _loadError ??= "The signed-in profile could not be identified. Sign out and sign in again.";
        _clockTimer.Elapsed += OnClockTick;
        _clockTimer.Start();
        await RefreshAsync();
    }

    private void OnClockTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        _now = DateTimeOffset.UtcNow;
        // Auto-dismiss a success bind alert ~6s after it appeared.
        if (_bindAlert is { } a && a.Succeeded && DateTimeOffset.UtcNow - a.ShownAt >= TimeSpan.FromSeconds(6))
            _bindAlert = null;
