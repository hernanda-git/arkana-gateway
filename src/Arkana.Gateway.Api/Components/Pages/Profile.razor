    {
        if (_binding)
            return;

        if (_ownerUserId == Guid.Empty)
        {
            _bindAlert = new BindAlert(false,
                "Your signed-in profile could not be identified. Sign out and sign in again.",
                DateTimeOffset.UtcNow);
            return;
        }

        var candidate = _keyToBind.Trim();
        if (candidate.Length == 0)
        {
            _bindAlert = new BindAlert(false, "Paste the complete API key first.", DateTimeOffset.UtcNow);
            return;
        }

        _binding = true;
        _bindAlert = null;
        try
        {
            var result = await Dashboard.BindApiKeyToUserAsync(_ownerUserId, candidate);
            _bindAlert = new BindAlert(result.Success, result.Message, DateTimeOffset.UtcNow);
            if (result.Success)
            {
                _keyToBind = string.Empty;
                await RefreshAsync();
            }
