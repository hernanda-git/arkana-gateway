    private void CloseDeleteAccount() { showDeleteAccount = false; }

    private async Task DeleteAccountConfirmed()
    {
        await Svc.DeleteProviderAsync(deleteAccountId);
        showDeleteAccount = false;
        await LoadData();
    }

    private async Task OpenOAuthConnect(string code, string name)
    {
        oauthProviderCode = code;
        oauthProviderName = name;
        oauthError = null;
        oauthCurrentStatus = "Pending";
        oauthStart = null;
        showOAuth = true;
        StateHasChanged();

        try
        {
            oauthStart = await Svc.StartOAuthAsync(code);
            await RefreshOAuthStatus();
            _ = PollOAuthNow();
        }
        catch (Exception ex)
        {
            oauthError = FormatUiError(ex, "OAuth authorization");
            oauthCurrentStatus = "Error";
            StateHasChanged();
        }
    }

    private void CloseOAuth()
    {
        showOAuth = false;
        oauthPolling = false;
        _ = LoadData();
    }

    private void StartAutoPoll()
    {
        _ = PollOAuthNow();
    }

    private async Task RefreshOAuthStatus()
    {
        var status = await Svc.GetOAuthStatusAsync(oauthProviderCode);
        oauthCurrentStatus = status.Status.ToString();
        oauthError = status.LastError;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PollOAuthNow()
    {
        oauthPolling = true;
        StateHasChanged();
        try
        {
            for (int i = 0; i < 60; i++)
            {
                // Device-code flows (e.g. ChatGPT) poll OpenAI and complete server-side.
                var status = oauthStart?.IsDeviceCode == true
                    ? await Svc.PollDeviceOAuthAsync(oauthProviderCode)
                    : (await Svc.GetOAuthStatusAsync(oauthProviderCode)).Status.ToString();
                oauthCurrentStatus = status;
                oauthError = (await Svc.GetOAuthStatusAsync(oauthProviderCode)).LastError;
                await InvokeAsync(StateHasChanged);
                if (oauthCurrentStatus is "Connected" or "Error") break;
                await Task.Delay(2000);
            }
        }
        catch (Exception ex)
        {
            oauthError = FormatUiError(ex, "OAuth status check");
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            oauthPolling = false;
            StateHasChanged();
        }
    }

    private async Task DisconnectOAuthProvider(string code, string name)
    {
        await Svc.DisconnectOAuthAsync(code);
        showOAuth = false;
        await LoadData();
    }

    // ── Sync ─────────────────────────────────────────────────
    private async Task SyncProvider(Guid id, string name)
    {
        syncing = true;
        try
        {
            var result = await Svc.SyncModelsAsync(id);
            syncMessage = $"{name}: {result.Added} new models added ({result.Total} total)";
            await LoadData();
        }
        catch (Exception ex)
        {
            syncMessage = $"{name}: sync failed — {ex.Message}";
        }
        finally { syncing = false; }
    }

    private async Task SyncAll()
    {
        if (providers is null) return;
        syncing = true;
        syncMessage = null;
        var totalAdded = 0;
        var totalFailed = 0;
        foreach (var p in providers)
        {
            try { var result = await Svc.SyncModelsAsync(p.Id); totalAdded += result.Added; }
            catch { totalFailed++; }
        }
        syncMessage = $"Sync complete: {totalAdded} new models added";
        if (totalFailed > 0) syncMessage += $", {totalFailed} providers failed";
        await LoadData();
        syncing = false;
    }

    private static bool IsTenantUnavailable(Exception ex)
        => ex.Message.Equals("Authenticated tenant is required.", StringComparison.Ordinal);

    private static string FormatUiError(Exception ex, string operation)
    {
        if (ex is InvalidOperationException && (
            ex.Message.StartsWith("An OAuth configuration", StringComparison.Ordinal)
            || ex.Message.StartsWith("The selected OAuth configuration", StringComparison.Ordinal)
            || ex.Message.StartsWith("No OAuth config", StringComparison.Ordinal)
            || ex.Message.StartsWith("No AiProvider", StringComparison.Ordinal)
            || ex.Message.Contains("already in use", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("tenant is required", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("tenant context", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("Broker slot", StringComparison.OrdinalIgnoreCase)))
        {
            return ex.Message;
        }

        return $"{operation} failed. Verify the selected OAuth provider and staging database migrations, then try again.";
    }

    [Inject] private DashboardService Svc { get; set; } = default!;
}
