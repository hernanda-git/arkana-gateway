    // ── Models ───────────────────────────────────────────────
    private async Task OpenModels(Guid providerId, string providerName) { modelsProviderId = providerId; modelsProviderName = providerName; newModelName = ""; newModelCode = ""; newModelCostIn = "0"; newModelCostOut = "0"; newModelMaxTokens = null; await RefreshModels(); showModels = true; }
    private async Task RefreshModels() { var models = await Svc.GetModelsByProviderAsync(modelsProviderId); currentModels = models.Select(m => new DashboardService.ModelManageView(m.Id, m.ProviderId, m.ProviderName, m.Name, m.Code, m.IsEnabled, m.CostPerInputToken, m.CostPerOutputToken, null)).ToList(); }
    private void CloseModels() { showModels = false; }

    private async Task SubmitAddModel()
    {
        if (string.IsNullOrWhiteSpace(newModelName) || string.IsNullOrWhiteSpace(newModelCode)) return;
        decimal.TryParse(newModelCostIn, out var costIn);
        decimal.TryParse(newModelCostOut, out var costOut);
        await Svc.CreateModelAsync(modelsProviderId, newModelName.Trim(), newModelCode.Trim().ToLowerInvariant(), costIn, costOut, newModelMaxTokens);
        newModelName = ""; newModelCode = ""; newModelCostIn = "0"; newModelCostOut = "0"; newModelMaxTokens = null;
        await RefreshModels(); await LoadData();
    }

    private async Task ToggleModel(Guid id) { await Svc.ToggleModelAsync(id); await RefreshModels(); await LoadData(); }
    private void DeleteModel(Guid id, string name) { deleteModelId = id; _deletingModelName = name; showDeleteModel = true; }
    private async Task DeleteModelConfirmed() { await Svc.DeleteModelAsync(deleteModelId); showDeleteModel = false; await RefreshModels(); await LoadData(); }
    private void CloseDeleteModel() { showDeleteModel = false; }

    // ── Add Account ─────────────────────────────────────────
    private void OpenAddAccount(string cfgCode, Guid cfgId, string displayName)
    {
        addAccountProviderCode = cfgCode;
        addAccountConfigId = cfgId;
        addAccountDisplayName = displayName;
        addAccountLabel = "";
        addAccountError = null;
        addingAccount = false;
        showAddAccount = true;
    }

    private void CloseAddAccount() { showAddAccount = false; }

    private async Task HandleAddAccountKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(addAccountLabel))
            await SubmitAddAccount();
    }

    private async Task SubmitAddAccount()
    {
        if (addingAccount || string.IsNullOrWhiteSpace(addAccountLabel)) return;
        var label = addAccountLabel.Trim();
        addingAccount = true;
        addAccountError = null;

        try
        {
            var providerCode = await Svc.CreateOAuthAccountAsync(addAccountConfigId, addAccountProviderCode, label);
            await LoadData();
            showAddAccount = false;
            await OpenOAuthConnect(providerCode, label);
        }
        catch (Exception ex)
        {
            addAccountError = FormatUiError(ex, "OAuth account creation");
        }
        finally
        {
            addingAccount = false;
        }
    }

