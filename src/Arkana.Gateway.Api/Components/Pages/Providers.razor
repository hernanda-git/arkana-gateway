    private bool showDeleteProvider;
    private Guid deleteProviderId;
    private string _deletingProviderName = "";
    private bool showDeleteModel;
    private Guid deleteModelId;
    private string _deletingModelName = "";
    private bool showDeleteAccount;
    private Guid deleteAccountId;

    private string newModelName = "";
    private string newModelCode = "";
    private string newModelCostIn = "0";
    private string newModelCostOut = "0";
    private int? newModelMaxTokens;

    // ── OAuth ────────────────────────────────────────────────
    private bool showOAuth;
    private string oauthProviderCode = "";
    private string oauthProviderName = "";
    private OAuthStartResult? oauthStart;
    private string oauthCurrentStatus = "Pending";
    private string? oauthError;
    private bool oauthPolling;

    // ── Add Account modal ────────────────────────────────────
    private bool showAddAccount;
    private string addAccountProviderCode = "";
    private Guid addAccountConfigId;
    private string addAccountDisplayName = "";
    private string addAccountLabel = "";
    private bool addingAccount;
    private string? addAccountError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        oauthConfigs = await Svc.GetOAuthConfigsAsync();
        providers = await Svc.GetProvidersAsync();
        modelsByProvider = [];
        oauthStatus = [];
        if (providers is not null)
        {
            foreach (var p in providers)
            {
                var models = await Svc.GetModelsByProviderAsync(p.Id);
                modelsByProvider[p.Id] = models.Select(m => new DashboardService.ModelManageView(
                    m.Id, m.ProviderId, m.ProviderName,
                    m.Name, m.Code, m.IsEnabled,
                    m.CostPerInputToken, m.CostPerOutputToken, null)).ToList();
                if (p.AuthMethod == "OAuth")
                {
                    try
                    {
                        oauthStatus[p.Id] = await Svc.GetOAuthStatusAsync(p.Code);
                    }
                    catch (InvalidOperationException ex) when (IsTenantUnavailable(ex))
                    {
                        // Staging may prerender the page before the dashboard
                        // cookie/circuit has established its tenant. Keep the
                        // page renderable; account actions still fail closed.
                    }
                }
            }
        }
        // Load OAuth accounts per config
        oauthAccounts = [];
        if (oauthConfigs is not null)
        {
            foreach (var cfg in oauthConfigs.Where(c => !c.ProviderCode.Equals("gemini", StringComparison.OrdinalIgnoreCase)))
            {
                try
                {
                    var accounts = await Svc.GetOAuthAccountsAsync(cfg.Id);
                    oauthAccounts[cfg.Id] = accounts;
                }
                catch (InvalidOperationException ex) when (IsTenantUnavailable(ex))
                {
                    oauthAccounts[cfg.Id] = [];
                }
            }
        }
    }

    // ── Toggle ───────────────────────────────────────────────
    private async Task Toggle(Guid id)
    {
        await Svc.ToggleProviderAsync(id);
        await LoadData();
    }

    // ── Create ───────────────────────────────────────────────
    private void OpenCreate() { showCreate = true; createName = ""; createCode = ""; createBaseUrl = null; createApiKey = null; createPriority = 5; createAuthMethod = "ApiKey"; createOAuthConfigId = Guid.Empty; }
    private void CloseCreate() { showCreate = false; }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(createName) || string.IsNullOrWhiteSpace(createCode)) return;
        var normalizedCode = createCode.Trim().ToLowerInvariant();
        var oauthSelected = createAuthMethod == "OAuth";
        var oauthConfigId = oauthSelected ? createOAuthConfigId : (Guid?)null;
        if (oauthSelected && oauthConfigId == Guid.Empty)
        {
            syncMessage = "Select a configured OAuth provider before creating this provider.";
            return;
        }
        try
        {
            await Svc.CreateProviderAsync(createName.Trim(), normalizedCode,
                oauthSelected ? null : (string.IsNullOrWhiteSpace(createBaseUrl) ? null : createBaseUrl.Trim()),
                createAuthMethod == "ApiKey" ? (string.IsNullOrWhiteSpace(createApiKey) ? null : createApiKey) : null,
                createPriority, 0, 0, null,
                authMethod: createAuthMethod, oAuthConfigId: oauthConfigId);
            showCreate = false;
            await LoadData();
            if (oauthSelected && oauthConfigId is not null)
                await OpenOAuthConnect(normalizedCode, createName.Trim());
        }
        catch (Exception ex)
        {
            syncMessage = FormatUiError(ex, "Provider creation");
        }
    }

    // ── Edit ─────────────────────────────────────────────────
    private void OpenEdit(DashboardService.ProviderView p) { showEdit = true; editId = p.Id; editOrigName = p.Name; editName = p.Name; editCode = p.Code; editBaseUrl = p.BaseUrl; editApiKey = null; editPriority = p.Priority; editAuthMethod = p.AuthMethod; editOAuthConfigId = p.OAuthConfigId ?? Guid.Empty; }
    private void CloseEdit() { showEdit = false; }

    private async Task SubmitEdit()
    {
        var oauthConfigId = editAuthMethod == "OAuth" ? editOAuthConfigId : (Guid?)null;
        await Svc.UpdateProviderAsync(editId, editName.Trim(), editCode.Trim().ToLowerInvariant(),
            editAuthMethod == "OAuth" ? null : (string.IsNullOrWhiteSpace(editBaseUrl) ? null : editBaseUrl.Trim()),
            editAuthMethod == "ApiKey" ? (string.IsNullOrWhiteSpace(editApiKey) ? null : editApiKey) : null,
            editPriority, 0, 0, null,
            authMethod: editAuthMethod, oAuthConfigId: oauthConfigId);
        showEdit = false;
        await LoadData();
    }

