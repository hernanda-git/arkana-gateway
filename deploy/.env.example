# ─────────────────────────────────────────────────────────────────────────────
# deploy/.env — copy this file to deploy/.env and fill in the values.
#
#   cp deploy/.env.example deploy/.env
#
# Only the three values in "REQUIRED TO START" have no usable default: with just
# those set, `docker compose -f deploy/docker-compose.yml up -d --build` brings up
# the whole stack (Postgres, Redis, Qdrant, n8n, gateway) and the dashboard is
# reachable at http://localhost:5011. Everything below "OPTIONAL" can be left
# empty — those sections only matter once you use the feature they belong to.
#
# deploy/.env is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED TO START
# ═════════════════════════════════════════════════════════════════════════════

# n8n's credential encryption key. The compose refuses to start without it.
# Generate:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Dashboard login. AUTH=1 is hardcoded in the compose, and the gateway refuses to
# seed an admin user without a password — an empty value here means you cannot log
# in at all ("ARKANA_ADMIN_PASSWORD is required when no admin user exists").
ARKANA_ADMIN_USER=admin
ARKANA_ADMIN_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════════
# RECOMMENDED
# ═════════════════════════════════════════════════════════════════════════════

# Wraps the per-tenant DEKs that encrypt provider credentials at rest (AES-256-GCM).
# Base64 that decodes to exactly 32 bytes:   openssl rand -base64 32
# When empty the gateway auto-generates one and persists it to the
# dataprotection volume — fine for a single host, but then the key lives with the
# volume: back it up, or set it here so a rebuilt stack can still read old records.
ARKANA_MASTER_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — upstream providers
# ═════════════════════════════════════════════════════════════════════════════

# The gateway starts fine without any upstream credential: providers and their
# keys can also be added from the dashboard (/providers) and are stored encrypted.
# These two are read from the environment as a fallback for the seeded provider rows.

# https://openrouter.ai/keys — used as the env fallback for the OpenRouter
# provider row (deploy/infra/04-provision-openrouter.sql).
OPENROUTER_API_KEY=
# opencode.ai/zen/go/v1 key.
OPENCODE_GO_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — automation / admin API
# ═════════════════════════════════════════════════════════════════════════════

# Required to call /admin/* programmatically (scripts, smoke tests, provisioning).
# A signed-in dashboard Admin also works. When unset the surface simply stays
# unreachable — it fails closed, it does not fail open.
# Generate:  openssl rand -hex 32
ADMIN_API_KEY=

# Tenant token budgets + the monthly auto-reset background job.
BUDGET_ENFORCER_ENABLED=false

# Gateway → n8n authentication (used by the workflow engine integration).
N8N_USER_EMAIL=
N8N_USER_PASSWORD=
# n8n's own admin login (the container reads these directly).
N8N_EMAIL=
N8N_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Google login for the dashboard
# ═════════════════════════════════════════════════════════════════════════════

# Authorization Code + PKCE. Create a Google Cloud OAuth "Web" client whose
# redirect URI is <your-host>/signin-google, then set Enabled=true.
# Empty AllowedDomains accepts any Google account; AdminEmails (csv) grants Admin.
GoogleLogin__Enabled=false
GoogleLogin__ClientId=
GoogleLogin__ClientSecret=
GoogleLogin__AllowedDomains=
GoogleLogin__DefaultRole=User
GoogleLogin__AdminEmails=


# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Gemini subscription (Antigravity) accounts
# ═════════════════════════════════════════════════════════════════════════════

# Only needed if you want to route through Gemini/Antigravity subscription
# accounts. These accounts are served by a local CLIProxyAPI broker ("slot"):
# one container per Google identity. See deploy/gemini-broker/README.md.
#
#   1. create a slot:      deploy/gemini-broker/add-slot.sh <slot> --wire
#   2. wire the gateway (the slot lines under the gateway service in
#      docker-compose.yml are commented out until you have a slot to point at)
#   3. GeminiSubscription__ProviderId must be set to the AiProviders.Id of the
#      gemini-subscription provider, otherwise streaming answers
#      503 "Gemini subscription streaming failed." while non-streaming works.
#
# Broker slot management key (one per slot; the slot generator writes these).
# GEMINI_BROKER_A_MANAGEMENT_KEY=
# GEMINI_BROKER_SLOT=a

# Google OAuth client used by the Antigravity/CLI sign-in flow (broker side).
OAUTH_GEMINI_CLIENT_ID=
OAUTH_GEMINI_CLIENT_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# NOT CONFIGURED HERE
# ═════════════════════════════════════════════════════════════════════════════
# Postgres, Redis and Qdrant credentials are hardcoded in docker-compose.yml
# (arkana / arkana_dev, and local-only bindings). They are development
# defaults baked into the compose file, not .env values — changing them there
# would desynchronise the containers from the gateway's connection string.
# For anything beyond a local stack, set ConnectionStrings__Postgres on the
# gateway service instead of adding POSTGRES_* here.
