+func TestServerRedirectUsesDedicatedOAuthClient(t *testing.T) {
+	t.Setenv("ANTIGRAVITY_OAUTH_REDIRECT_URI", "https://staging.example.test/oauth/gemini/callback")
+	t.Setenv("ANTIGRAVITY_OAUTH_CLIENT_ID", "dedicated-web-client")
+	t.Setenv("ANTIGRAVITY_OAUTH_CLIENT_SECRET", "dedicated-web-secret")
+
+	auth := NewAntigravityAuth(nil, &http.Client{})
+	got := auth.BuildAuthURL("state", "https://staging.example.test/oauth/gemini/callback")
+	if !strings.Contains(got, "client_id=dedicated-web-client") {
+		t.Fatalf("BuildAuthURL did not use dedicated client: %s", got)
+	}
+	if strings.Contains(got, ClientID) {
+		t.Fatalf("BuildAuthURL used stock client: %s", got)
+	}
+}
