+func antigravityCallbackRedirectURI() (string, bool, error) {
+	const configuredKey = "ANTIGRAVITY_OAUTH_REDIRECT_URI"
+	raw := strings.TrimSpace(os.Getenv(configuredKey))
+	if raw == "" {
+		return fmt.Sprintf("http://localhost:%d/oauth-callback", antigravity.CallbackPort), false, nil
+	}
+	if strings.TrimSpace(os.Getenv("ANTIGRAVITY_OAUTH_CLIENT_ID")) == "" ||
+		strings.TrimSpace(os.Getenv("ANTIGRAVITY_OAUTH_CLIENT_SECRET")) == "" {
+		return "", true, fmt.Errorf("%s requires ANTIGRAVITY_OAUTH_CLIENT_ID and ANTIGRAVITY_OAUTH_CLIENT_SECRET", configuredKey)
+	}
+	parsed, errParse := url.ParseRequestURI(raw)
+	if errParse != nil || parsed.Scheme != "https" || parsed.Host == "" || parsed.Path == "" ||
+		parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return "", true, fmt.Errorf("%s must be an absolute HTTPS URL without userinfo, query, or fragment", configuredKey)
+	}
+	return raw, true, nil
+}
